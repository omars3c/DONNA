# D.O.N.N.A. environment template — copy to .env (gitignored) or set in your shell.
# Environment variables take precedence over config/api_keys.json.

# Gemini (voice / Gemini Live + text). Backups: GEMINI_API_KEY_1 ... GEMINI_API_KEY_9
GEMINI_API_KEY=

# Cerebras — secondary TEXT-only provider (tests, background text jobs).
# Not used by the Gemini Live voice channel. Check: uv run python scripts/cerebras_check.py
CEREBRAS_API_KEY=

# Inter-service auth token (optional)
DONNA_INTERNAL_TOKEN=
