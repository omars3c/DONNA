# =============================================================================
# D.O.N.N.A. — Security-Hardened .gitignore
# =============================================================================

# ── 1. Secrets, Credentials & API Keys (CRITICAL SECURITY) ───────────────────
config/api_keys.json
config/api_keys*.json
!config/api_keys.example.json
*secret*.json
*credentials*.json
service_account*.json
client_secret*.json
auth.json
tokens.json
token.json

# Environment files
.env
.env.*
!.env.example
*.env
*.token

# Certificates & Cryptographic Keys
*.pem
*.key
*.cert
*.crt
*.cer
*.pfx
*.p12
id_rsa*
id_ed25519*
config/certs/

# ── 2. Databases & Persistent State ──────────────────────────────────────────
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
memory/*.db*
memory/cortex.db*
memory/sentinel.db*
chroma_db/
lancedb/
vector_store/

# ── 3. Runtime Logs, Telemetry & Dumps ───────────────────────────────────────
logs/
*.log
*.log.*
*.jsonl
sentinel_fallback.jsonl
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.dmp
*.dump
*.stackdump
core.[0-9]*

# ── 4. Python Bytecode, Caches & Virtual Environments ────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# ── 5. Node / Web Frontend Caches ────────────────────────────────────────────
node_modules/
.pnpm-store/
.next/
out/
.nuxt/
.cache/

# ── 6. Temporary Files, Audio & Scratch Artifacts ─────────────────────────────
*.tmp
*.temp
tmp/
temp/
scratch/
recordings/
*.wav
*.mp3
*.webm
*.ogg

# ── 7. Operating System & IDE Files ──────────────────────────────────────────
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~

# IDEs
.vscode/
.idea/
*.swp
*.swo
